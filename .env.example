# AstAx local environment. Copy with `pnpm env:init`: it writes .env and replaces
# every __GENERATE__ with a random value. .env is ignored by git (CLAUDE.md rule 12).
# Development values only: never put real credentials here.

NODE_ENV=development
# Development tools (movable clock, early timers, test offers): never true in production (rule 13)
DEV_TOOLS=true

# API
API_PORT=4000
API_URL=http://127.0.0.1:${API_PORT}
# Web apps (privati, broker e agenzie) and back office
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# true only behind our own proxy (cloud): then the last X-Forwarded-For entry is the
# browser's address, recorded in the audit log and legal acceptances (ADR 0004)
WEB_TRUSTED_PROXY=false
LOG_LEVEL=info

# PostgreSQL (docker compose, port 5433 to leave a local 5432 free)
POSTGRES_PORT=5433
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
ASTAX_DB_OWNER_PASSWORD=__GENERATE__
ASTAX_DB_APP_PASSWORD=__GENERATE__
KEYCLOAK_DB_PASSWORD=__GENERATE__
# Migrations run as astax_owner; API and worker connect as astax_app (row level security applies)
DATABASE_OWNER_URL=postgresql://astax_owner:${ASTAX_DB_OWNER_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/astax
DATABASE_URL=postgresql://astax_app:${ASTAX_DB_APP_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/astax

# Redis
REDIS_PORT=6380
REDIS_PASSWORD=__GENERATE__
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:${REDIS_PORT}

# Keycloak
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__
KEYCLOAK_URL=http://localhost:${KEYCLOAK_PORT}
KEYCLOAK_REALM=astax
# Service account used by the API to manage users and sessions (realm import placeholder)
KEYCLOAK_API_ADMIN_SECRET=__GENERATE__
# Password of every synthetic professional and staff user in development (README)
DEV_USERS_PASSWORD=__GENERATE__

# Temporal dev server
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_NAMESPACE=astax

# S3-compatible storage (SeaweedFS)
S3_PORT=8333
S3_ACCESS_KEY=__GENERATE__
S3_SECRET_KEY=__GENERATE__

# Mailpit: every email and SMS of development ends up here
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Local master keys of the fake KMS (docs/busta-chiusa.md); the worker and the API each load only their own
SEALED_BIDS_MASTER_KEY=__GENERATE__
OFFER_OWNER_MASTER_KEY=__GENERATE__
# Field encryption and blind index (SIC-03)
FIELD_ENCRYPTION_KEY=__GENERATE__
BLIND_INDEX_KEY=__GENERATE__
