{
  "realm": "astax",
  "enabled": true,
  "displayName": "AstAx",
  "loginTheme": "astax",
  "emailTheme": "astax",
  "internationalizationEnabled": true,
  "supportedLocales": ["it"],
  "defaultLocale": "it",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@astax.test",
    "fromDisplayName": "AstAx",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "astax-private",
        "description": "Private customer: email code login only"
      },
      {
        "name": "astax-professional",
        "description": "Broker, agency or sub-agent user: password and TOTP"
      },
      {
        "name": "astax-staff",
        "description": "AstAx back office or administrator: password and TOTP"
      }
    ]
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 40
    },
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90
    },
    {
      "alias": "TERMS_AND_CONDITIONS",
      "name": "Terms and Conditions",
      "providerId": "TERMS_AND_CONDITIONS",
      "enabled": false,
      "defaultAction": false,
      "priority": 20
    }
  ],
  "authenticatorConfig": [
    {
      "id": "0199e5c0-0000-7000-8000-00000000c0de",
      "alias": "astax-email-code-config",
      "config": {
        "codeTtlMinutes": "10",
        "maxAttempts": "5",
        "codeLength": "6"
      }
    }
  ],
  "authenticationFlows": [
    {
      "id": "0199e5c0-0000-7000-8000-000000000001",
      "alias": "astax-private-browser",
      "description": "Private customers: one-time code by email, no password (SIC-05)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "astax-email-code",
          "authenticatorConfig": "astax-email-code-config",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "id": "0199e5c0-0000-7000-8000-000000000002",
      "alias": "astax-professional-browser",
      "description": "Professionals and staff: password and mandatory TOTP (SIC-05)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": true
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "astax-web-private",
      "name": "AstAx — privati",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*",
        "client.session.idle.timeout": "2592000",
        "client.session.max.lifespan": "2592000"
      },
      "authenticationFlowBindingOverrides": {
        "browser": "0199e5c0-0000-7000-8000-000000000001"
      },
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "roles", "email"],
      "protocolMappers": [
        {
          "name": "astax-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "astax-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "astax-web-pro",
      "name": "AstAx — broker e agenzie",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*",
        "client.session.idle.timeout": "28800"
      },
      "authenticationFlowBindingOverrides": {
        "browser": "0199e5c0-0000-7000-8000-000000000002"
      },
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "roles", "email"],
      "protocolMappers": [
        {
          "name": "astax-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "astax-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "astax-admin",
      "name": "AstAx — back office",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3001"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001/*",
        "client.session.idle.timeout": "3600"
      },
      "authenticationFlowBindingOverrides": {
        "browser": "0199e5c0-0000-7000-8000-000000000002"
      },
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "roles", "email"],
      "protocolMappers": [
        {
          "name": "astax-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "astax-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "astax-api-admin",
      "name": "AstAx API — administration of users and sessions",
      "publicClient": false,
      "secret": "${KEYCLOAK_API_ADMIN_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "roles"]
    }
  ],
  "users": [
    {
      "username": "service-account-astax-api-admin",
      "enabled": true,
      "serviceAccountClientId": "astax-api-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "manage-realm",
          "view-realm",
          "view-clients",
          "manage-clients",
          "view-events"
        ]
      }
    }
  ]
}
