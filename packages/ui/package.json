{
  "name": "@astax/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@astax/adapters": "workspace:*",
    "@astax/shared": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "openid-client": "6.8.8",
    "redis": "6.3.0",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@astax/config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "eslint": "10.12.0",
    "react": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
