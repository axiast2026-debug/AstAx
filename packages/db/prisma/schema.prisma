// AstAx database schema, built phase by phase (docs/modello-dati.md).
// Conventions: UUID v7 ids generated by the application; timestamps in UTC set
// by the database (createdAt default, updatedAt trigger, ADR 0001); money in
// integer cents; encrypted fields end in Enc, blind indexes in Hash (SIC-03).
// Row level security and the audit log lock are in hand-written migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity and organizations (phase 1)
// ---------------------------------------------------------------------------

enum UserKind {
  PRIVATE
  PROFESSIONAL
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum Locale {
  it
  sq
}

model User {
  id         String     @id @default(uuid(7)) @db.Uuid
  keycloakId String?    @unique
  kind       UserKind
  firstName  String
  lastName   String
  emailEnc   String?
  emailHash  String?    @unique
  phoneEnc   String?
  phoneHash  String?
  locale     Locale     @default(it)
  status     UserStatus @default(ACTIVE)
  /// Natural person behind the account (OFF-02); the Person table arrives in phase 2.
  personId   String?    @db.Uuid
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @default(now()) @db.Timestamptz(3)

  memberships      Membership[]
  legalAcceptances LegalAcceptance[]

  @@index([phoneHash])
}

enum OrganizationType {
  AGENCY
  BROKER
  ASTAX
}

enum RuiSection {
  A
  B
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXCLUDED
}

model Organization {
  id                     String             @id @default(uuid(7)) @db.Uuid
  type                   OrganizationType
  legalName              String
  vatNumber              String?
  fiscalCodeEnc          String?
  fiscalCodeHash         String?
  ruiNumber              String?
  ruiSection             RuiSection?
  pec                    String?
  address                Json?
  ibanEnc                String?
  status                 OrganizationStatus @default(PENDING)
  statusReason           String?
  profInsuranceExpiresOn DateTime?          @db.Date
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @default(now()) @db.Timestamptz(3)

  memberships Membership[]
  teamInvites TeamInvite[]

  @@index([fiscalCodeHash])
  @@index([ruiNumber])
}

enum MembershipRole {
  OWNER
  SUPERVISOR
  OPERATOR
  BO_VERIFIER
  BO_SUPPORT
  BO_ACCOUNTING
  BO_SUPERVISOR
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

/// The active context of a professional user is one Membership (X-AstAx-Context).
model Membership {
  id                    String           @id @default(uuid(7)) @db.Uuid
  userId                String           @db.Uuid
  organizationId        String           @db.Uuid
  role                  MembershipRole
  /// RUI number in section E, for collaborators of an agency or broker.
  ruiNumberE            String?
  ruiVerifiedAt         DateTime?        @db.Timestamptz(3)
  canIssue              Boolean          @default(false)
  canSeeColleagueOffers Boolean          @default(false)
  canSeeAccounting      Boolean          @default(false)
  seesAllClients        Boolean          @default(false)
  status                MembershipStatus @default(ACTIVE)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @default(now()) @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// Invitation to join a team; not to be confused with Invitation, the auction invite.
model TeamInvite {
  id                    String         @id @default(uuid(7)) @db.Uuid
  organizationId        String         @db.Uuid
  emailHash             String
  role                  MembershipRole
  canIssue              Boolean        @default(false)
  canSeeColleagueOffers Boolean        @default(false)
  canSeeAccounting      Boolean        @default(false)
  seesAllClients        Boolean        @default(false)
  tokenHash             String         @unique
  invitedByUserId       String         @db.Uuid
  expiresAt             DateTime       @db.Timestamptz(3)
  acceptedAt            DateTime?      @db.Timestamptz(3)
  revokedAt             DateTime?      @db.Timestamptz(3)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([emailHash])
}

// ---------------------------------------------------------------------------
// Legal documents (LEG-01 … LEG-03)
// ---------------------------------------------------------------------------

enum LegalAudience {
  PRIVATE
  BROKER
  AGENCY
  SUB_AGENT
  STAFF
  ALL
}

enum LegalMoment {
  FIRST_ACCESS
  REGISTRATION
  ONBOARDING
  BEFORE_REQUEST
  ACCEPTANCE
  FIRST_SIGNATURE
}

enum LegalVersionStatus {
  DRAFT
  VALIDATED
}

model LegalDocument {
  id        String          @id @default(uuid(7)) @db.Uuid
  key       String          @unique
  title     String
  audiences LegalAudience[]
  moment    LegalMoment
  /// Channel the document belongs to (PRIVATE, BROKER), when it depends on it (LEG-05).
  channel   String?
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @default(now()) @db.Timestamptz(3)

  versions LegalDocumentVersion[]
}

model LegalDocumentVersion {
  id                String             @id @default(uuid(7)) @db.Uuid
  documentId        String             @db.Uuid
  number            Int
  contentMd         String
  status            LegalVersionStatus @default(DRAFT)
  validatedByUserId String?            @db.Uuid
  validatedAt       DateTime?          @db.Timestamptz(3)
  publishedAt       DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @db.Timestamptz(3)

  document    LegalDocument     @relation(fields: [documentId], references: [id])
  acceptances LegalAcceptance[]

  @@unique([documentId, number])
}

enum LegalAcceptanceMethod {
  CLICK
  OTP
  FEA
  UPLOAD_BY_BROKER
}

model LegalAcceptance {
  id         String                @id @default(uuid(7)) @db.Uuid
  userId     String?               @db.Uuid
  /// Customer of a request (phase 2); the Customer table arrives then.
  customerId String?               @db.Uuid
  versionId  String                @db.Uuid
  acceptedAt DateTime              @db.Timestamptz(3)
  ip         String?
  userAgent  String?
  method     LegalAcceptanceMethod
  createdAt  DateTime              @default(now()) @db.Timestamptz(3)

  user    User?                @relation(fields: [userId], references: [id])
  version LegalDocumentVersion @relation(fields: [versionId], references: [id])

  @@index([userId])
  @@index([customerId])
  @@index([versionId])
}

// ---------------------------------------------------------------------------
// Parameters and lists (CLAUDE.md rule 7)
// ---------------------------------------------------------------------------

/// Every change is a new row: values are read by date (ASTA-09).
model Setting {
  id              String   @id @default(uuid(7)) @db.Uuid
  key             String
  value           Json
  version         Int
  validFrom       DateTime @db.Timestamptz(3)
  changedByUserId String?  @db.Uuid
  reason          String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([key, version])
  @@index([key, validFrom])
}

model ListValue {
  id        String   @id @default(uuid(7)) @db.Uuid
  listKey   String
  code      String
  labelIt   String
  labelSq   String
  active    Boolean  @default(true)
  sortOrder Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([listKey, code])
}

/// Italian municipalities from ISTAT (seed/comuni.csv): the cadastral code is
/// the one in the fiscal code.
model Municipality {
  istatCode     String   @id
  cadastralCode String   @unique
  province      String
  name          String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([name])
}

/// Excluded cases (ASTA-10), from the exclusionCase list of seed/elenchi.json.
model ExclusionRule {
  code             String   @id
  /// Extra machine-readable condition, for cases the automatic check detects.
  condition        Json?
  blockingInWizard Boolean
  messageIt        String
  messageSq        String
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @db.Timestamptz(3)
}

/// Coverage packages (spec 09 §2, seed/pacchetti.json). A request stores the
/// version it used.
model CoveragePackage {
  code      String                   @id
  name      String
  versions  CoveragePackageVersion[]
  createdAt DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                 @default(now()) @db.Timestamptz(3)
}

model CoveragePackageVersion {
  id             String          @id @default(uuid(7)) @db.Uuid
  packageCode    String
  package        CoveragePackage @relation(fields: [packageCode], references: [code])
  version        Int
  requirements   Json
  customerTextIt String
  validFrom      DateTime        @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([packageCode, version])
}

/// National holidays: auction time does not run (ASTA-02).
model Holiday {
  id        String   @id @default(uuid(7)) @db.Uuid
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// Audit log, domain events, outbox
// ---------------------------------------------------------------------------

/// Append only with a hash chain (SIC-04): UPDATE and DELETE are refused by the
/// database; each row contains the hash of the previous one.
model AuditLog {
  seq                 BigInt   @id @default(autoincrement())
  at                  DateTime @db.Timestamptz(3)
  actorUserId         String?  @db.Uuid
  actorMembershipId   String?  @db.Uuid
  actorOrganizationId String?  @db.Uuid
  action              String
  targetType          String?
  targetId            String?
  before              Json?
  after               Json?
  reason              String?
  ip                  String?
  userAgent           String?
  prevHash            String   @unique
  hash                String   @unique

  @@index([actorOrganizationId, at])
  @@index([targetType, targetId])
  @@index([action, at])
}

/// History shown to users; written in the same transaction as the state change.
model DomainEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  aggregateType String
  aggregateId   String   @db.Uuid
  type          String
  at            DateTime @db.Timestamptz(3)
  actorUserId   String?  @db.Uuid
  data          Json     @default("{}")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([aggregateType, aggregateId, at])
}

enum OutboxStatus {
  PENDING
  DELIVERED
  FAILED
}

/// Reliable delivery to notifications and Temporal. Payload: identifiers only (SIC-06).
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  type          String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @db.Timestamptz(3)
  lastErrorCode String?
  deliveredAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Customers and requests (phase 2, ADR 0007)
// Every row has an owner for row level security: ownerUserId for a private
// customer, ownerOrganizationId (+ ownerMembershipId) for a broker.
// ---------------------------------------------------------------------------

enum PersonKind {
  PERSON
  COMPANY
}

/// Contacts live only here, encrypted, never in quoteData (VIS-01).
model Customer {
  id                  String    @id @default(uuid(7)) @db.Uuid
  ownerUserId         String?   @db.Uuid
  ownerOrganizationId String?   @db.Uuid
  ownerMembershipId   String?   @db.Uuid
  personId            String    @db.Uuid
  emailEnc            String?
  emailHash           String?
  phoneEnc            String?
  phoneHash           String?
  contactsVerifiedAt  DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @db.Timestamptz(3)

  person        Person         @relation(fields: [personId], references: [id])
  vehicles      Vehicle[]
  quoteRequests QuoteRequest[]
  consents      Consent[]

  @@index([ownerUserId])
  @@index([ownerOrganizationId])
  @@index([emailHash])
  @@index([phoneHash])
}

model Person {
  id                  String     @id @default(uuid(7)) @db.Uuid
  ownerUserId         String?    @db.Uuid
  ownerOrganizationId String?    @db.Uuid
  kind                PersonKind
  surname             String?
  givenName           String?
  companyName         String?
  fiscalCodeEnc       String?
  fiscalCodeHash      String?
  vatNumber           String?
  birthDate           DateTime?  @db.Date
  birthPlace          String?
  sex                 String?
  /// Street, postal code, ISTAT code of the municipality, province.
  residence           Json?
  profession          String?
  maritalStatus       String?
  children            Int?
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @default(now()) @db.Timestamptz(3)

  customers Customer[]

  @@index([fiscalCodeHash])
  @@index([ownerOrganizationId])
}

model Vehicle {
  id                  String   @id @default(uuid(7)) @db.Uuid
  ownerUserId         String?  @db.Uuid
  ownerOrganizationId String?  @db.Uuid
  customerId          String   @db.Uuid
  plate               String
  /// Technical data as in quoteData.vehicle, without the plate.
  data                Json
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, plate])
}

enum RequestChannel {
  PRIVATE
  BROKER
}

enum QuoteRequestStatus {
  DRAFT
  IN_VERIFICATION
  INTEGRATION_REQUESTED
  EXCLUDED
  AUCTION_OPEN
  OFFERS_AVAILABLE
  DESERTED
  ACCEPTED
  IN_ISSUANCE
  ISSUED
  EXPIRED
  IN_RECONFIRMATION
  CANCELLED
}

enum CheckOutcome {
  GREEN
  YELLOW
  RED
}

model QuoteRequest {
  id                    String             @id @default(uuid(7)) @db.Uuid
  /// AX-2026-000001; prefix from requests.codePrefix.
  code                  String             @unique
  channel               RequestChannel
  ownerUserId           String?            @db.Uuid
  ownerOrganizationId   String?            @db.Uuid
  requesterUserId       String             @db.Uuid
  requesterMembershipId String?            @db.Uuid
  customerId            String?            @db.Uuid
  status                QuoteRequestStatus @default(DRAFT)
  /// QuoteDraft encrypted (ADR 0007); null after submission.
  draftEnc              String?
  /// Version of quoteData in force (QuoteDataVersion), null while a draft.
  quoteDataVersion      Int?
  plate                 String?
  vehicleType           String?
  province              String?
  cuClass               Int?
  claimsLast5y          Int?
  youngestDriverAge     Int?
  packageCode           String?
  startDate             DateTime?          @db.Date
  minValidityDays       Int?
  auctionDurationHours  Int?
  autoOutcome           CheckOutcome?
  aiComparisonUsed      Boolean            @default(false)
  reconfirmationsUsed   Int                @default(0)
  renewalOfPolicyId     String?            @db.Uuid
  submittedAt           DateTime?          @db.Timestamptz(3)
  cancelledAt           DateTime?          @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @default(now()) @db.Timestamptz(3)

  customer          Customer?           @relation(fields: [customerId], references: [id])
  quoteDataVersions QuoteDataVersion[]
  documents         Document[]
  verifications     Verification[]
  events            QuoteRequestEvent[]
  consentLinks      ConsentLink[]

  @@index([ownerUserId, status])
  @@index([ownerOrganizationId, status])
  @@index([status, submittedAt])
}

enum QuoteDataSource {
  SUBMISSION
  INTEGRATION
  BACK_OFFICE_CORRECTION
}

/// Append only (ADR 0007): every change of quoteData is a new version.
model QuoteDataVersion {
  id                  String          @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String          @db.Uuid
  ownerUserId         String?         @db.Uuid
  ownerOrganizationId String?         @db.Uuid
  version             Int
  dataEnc             String
  dataSha256          String
  source              QuoteDataSource
  /// Paths of the fields changed from the previous version.
  changedFields       Json            @default("[]")
  reason              String?
  createdByUserId     String          @db.Uuid
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  @@unique([quoteRequestId, version])
}

enum ConsentType {
  DATA_SHARING_AGENCIES
}

enum ConsentMethod {
  OTP_PRIVATE
  OTP_LINK
  UPLOADED_BY_BROKER
}

/// LEG-04: the customer's consent to share the request with the invited agencies.
model Consent {
  id                  String        @id @default(uuid(7)) @db.Uuid
  customerId          String        @db.Uuid
  ownerUserId         String?       @db.Uuid
  ownerOrganizationId String?       @db.Uuid
  quoteRequestId      String?       @db.Uuid
  type                ConsentType
  legalVersionId      String?       @db.Uuid
  method              ConsentMethod
  /// Identifiers only: OTP challenge, document, IP and browser.
  evidence            Json
  acceptedAt          DateTime      @db.Timestamptz(3)
  revokedAt           DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, type])
}

enum ConsentLinkStatus {
  SENT
  COMPLETED
  EXPIRED
  REVOKED
}

/// Link sent by a broker to the customer for the consent (consent.signature_request).
model ConsentLink {
  id                  String            @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String            @db.Uuid
  customerId          String            @db.Uuid
  ownerOrganizationId String            @db.Uuid
  tokenHash           String            @unique
  status              ConsentLinkStatus @default(SENT)
  expiresAt           DateTime          @db.Timestamptz(3)
  sentByUserId        String            @db.Uuid
  completedAt         DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])
}

enum OtpPurpose {
  PRIVATE_CONSENT
  LINK_CONSENT
}

/// One-time codes sent by AstAx (auth.otp), stored only as a keyed hash.
model OtpChallenge {
  id                  String     @id @default(uuid(7)) @db.Uuid
  purpose             OtpPurpose
  /// The request (private consent) or the consent link.
  subjectId           String     @db.Uuid
  ownerUserId         String?    @db.Uuid
  ownerOrganizationId String?    @db.Uuid
  codeHash            String
  expiresAt           DateTime   @db.Timestamptz(3)
  attempts            Int        @default(0)
  maxAttempts         Int
  consumedAt          DateTime?  @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @default(now()) @db.Timestamptz(3)

  @@index([subjectId, purpose])
}

enum DocumentKind {
  REGISTRATION_CERTIFICATE
  DRIVING_LICENCE
  RISK_CERTIFICATE
  FISCAL_CODE_CARD
  CONSENT_FORM
  OTHER
}

model Document {
  id                  String       @id @default(uuid(7)) @db.Uuid
  kind                DocumentKind
  ownerUserId         String?      @db.Uuid
  ownerOrganizationId String?      @db.Uuid
  quoteRequestId      String?      @db.Uuid
  customerId          String?      @db.Uuid
  /// For a licence: the driver's index in quoteData.drivers.
  driverIndex         Int?
  /// Opaque key, never a name (CLAUDE.md rule 8).
  storageKey          String       @unique
  sha256              String
  mime                String
  size                Int
  fileName            String
  encryption          String       @default("SSE_KMS")
  uploadedByUserId    String       @db.Uuid
  /// Fields read by the document reader, with confidence.
  extraction          Json?
  extractedAt         DateTime?    @db.Timestamptz(3)
  retainUntil         DateTime?    @db.Timestamptz(3)
  deletedAt           DateTime?    @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest? @relation(fields: [quoteRequestId], references: [id])

  @@index([quoteRequestId])
}

enum VerificationDecision {
  APPROVED
  INTEGRATION_REQUESTED
  EXCLUDED
}

/// One per submission round: the automatic check and the back office decision.
model Verification {
  id                  String                @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String                @db.Uuid
  ownerUserId         String?               @db.Uuid
  ownerOrganizationId String?               @db.Uuid
  round               Int
  quoteDataVersion    Int
  autoOutcome         CheckOutcome
  /// Items: code, automatic outcome, reasons, fields, correction, note.
  checklist           Json
  assignedToUserId    String?               @db.Uuid
  decision            VerificationDecision?
  reasonCodes         Json                  @default("[]")
  message             String?
  decidedByUserId     String?               @db.Uuid
  decidedAt           DateTime?             @db.Timestamptz(3)
  excludedAgencies    Json                  @default("[]")
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  @@unique([quoteRequestId, round])
  @@index([decision, createdAt])
}

/// The request's timeline, shown to requester and back office. Append only;
/// details hold codes and identifiers only.
model QuoteRequestEvent {
  id                  String   @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String   @db.Uuid
  ownerUserId         String?  @db.Uuid
  ownerOrganizationId String?  @db.Uuid
  type                String
  actorKind           String
  actorUserId         String?  @db.Uuid
  details             Json     @default("{}")
  at                  DateTime @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  @@index([quoteRequestId, at])
}

enum NotificationStatus {
  UNREAD
  READ
}

/// In-app notifications (docs/notifiche.md); payload holds identifiers and the rendered text only.
model Notification {
  id        String             @id @default(uuid(7)) @db.Uuid
  userId    String             @db.Uuid
  eventKey  String
  title     String
  body      String
  link      String?
  payload   Json               @default("{}")
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?          @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @default(now()) @db.Timestamptz(3)

  @@index([userId, status, createdAt])
}
