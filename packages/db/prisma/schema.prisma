// AstAx database schema, built phase by phase (docs/modello-dati.md).
// Conventions: UUID v7 ids generated by the application; timestamps in UTC set
// by the database (createdAt default, updatedAt trigger, ADR 0001); money in
// integer cents; encrypted fields end in Enc, blind indexes in Hash (SIC-03).
// Row level security and the audit log lock are in hand-written migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity and organizations (phase 1)
// ---------------------------------------------------------------------------

enum UserKind {
  PRIVATE
  PROFESSIONAL
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum Locale {
  it
  sq
}

model User {
  id         String     @id @default(uuid(7)) @db.Uuid
  keycloakId String?    @unique
  kind       UserKind
  firstName  String
  lastName   String
  emailEnc   String?
  emailHash  String?    @unique
  phoneEnc   String?
  phoneHash  String?
  locale     Locale     @default(it)
  status     UserStatus @default(ACTIVE)
  /// Natural person behind the account (OFF-02); the Person table arrives in phase 2.
  personId   String?    @db.Uuid
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @default(now()) @db.Timestamptz(3)

  memberships      Membership[]
  legalAcceptances LegalAcceptance[]

  @@index([phoneHash])
}

enum OrganizationType {
  AGENCY
  BROKER
  ASTAX
}

enum RuiSection {
  A
  B
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXCLUDED
}

model Organization {
  id                     String             @id @default(uuid(7)) @db.Uuid
  type                   OrganizationType
  legalName              String
  vatNumber              String?
  fiscalCodeEnc          String?
  fiscalCodeHash         String?
  ruiNumber              String?
  ruiSection             RuiSection?
  pec                    String?
  address                Json?
  ibanEnc                String?
  status                 OrganizationStatus @default(PENDING)
  statusReason           String?
  profInsuranceExpiresOn DateTime?          @db.Date
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @default(now()) @db.Timestamptz(3)

  memberships Membership[]
  teamInvites TeamInvite[]

  @@index([fiscalCodeHash])
  @@index([ruiNumber])
}

enum MembershipRole {
  OWNER
  SUPERVISOR
  OPERATOR
  BO_VERIFIER
  BO_SUPPORT
  BO_ACCOUNTING
  BO_SUPERVISOR
  ADMIN
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

/// The active context of a professional user is one Membership (X-AstAx-Context).
model Membership {
  id                    String           @id @default(uuid(7)) @db.Uuid
  userId                String           @db.Uuid
  organizationId        String           @db.Uuid
  role                  MembershipRole
  /// RUI number in section E, for collaborators of an agency or broker.
  ruiNumberE            String?
  ruiVerifiedAt         DateTime?        @db.Timestamptz(3)
  canIssue              Boolean          @default(false)
  canSeeColleagueOffers Boolean          @default(false)
  canSeeAccounting      Boolean          @default(false)
  seesAllClients        Boolean          @default(false)
  status                MembershipStatus @default(ACTIVE)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @default(now()) @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// Invitation to join a team; not to be confused with Invitation, the auction invite.
model TeamInvite {
  id                    String         @id @default(uuid(7)) @db.Uuid
  organizationId        String         @db.Uuid
  emailHash             String
  role                  MembershipRole
  canIssue              Boolean        @default(false)
  canSeeColleagueOffers Boolean        @default(false)
  canSeeAccounting      Boolean        @default(false)
  seesAllClients        Boolean        @default(false)
  tokenHash             String         @unique
  invitedByUserId       String         @db.Uuid
  expiresAt             DateTime       @db.Timestamptz(3)
  acceptedAt            DateTime?      @db.Timestamptz(3)
  revokedAt             DateTime?      @db.Timestamptz(3)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([emailHash])
}

// ---------------------------------------------------------------------------
// Legal documents (LEG-01 … LEG-03)
// ---------------------------------------------------------------------------

enum LegalAudience {
  PRIVATE
  BROKER
  AGENCY
  SUB_AGENT
  STAFF
  ALL
}

enum LegalMoment {
  FIRST_ACCESS
  REGISTRATION
  ONBOARDING
  BEFORE_REQUEST
  ACCEPTANCE
  FIRST_SIGNATURE
}

enum LegalVersionStatus {
  DRAFT
  VALIDATED
}

model LegalDocument {
  id        String          @id @default(uuid(7)) @db.Uuid
  key       String          @unique
  title     String
  audiences LegalAudience[]
  moment    LegalMoment
  /// Channel the document belongs to (PRIVATE, BROKER), when it depends on it (LEG-05).
  channel   String?
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @default(now()) @db.Timestamptz(3)

  versions LegalDocumentVersion[]
}

model LegalDocumentVersion {
  id                String             @id @default(uuid(7)) @db.Uuid
  documentId        String             @db.Uuid
  number            Int
  contentMd         String
  status            LegalVersionStatus @default(DRAFT)
  validatedByUserId String?            @db.Uuid
  validatedAt       DateTime?          @db.Timestamptz(3)
  publishedAt       DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @db.Timestamptz(3)

  document    LegalDocument     @relation(fields: [documentId], references: [id])
  acceptances LegalAcceptance[]

  @@unique([documentId, number])
}

enum LegalAcceptanceMethod {
  CLICK
  OTP
  FEA
  UPLOAD_BY_BROKER
}

model LegalAcceptance {
  id         String                @id @default(uuid(7)) @db.Uuid
  userId     String?               @db.Uuid
  /// Customer of a request (phase 2); the Customer table arrives then.
  customerId String?               @db.Uuid
  versionId  String                @db.Uuid
  acceptedAt DateTime              @db.Timestamptz(3)
  ip         String?
  userAgent  String?
  method     LegalAcceptanceMethod
  createdAt  DateTime              @default(now()) @db.Timestamptz(3)

  user    User?                @relation(fields: [userId], references: [id])
  version LegalDocumentVersion @relation(fields: [versionId], references: [id])

  @@index([userId])
  @@index([customerId])
  @@index([versionId])
}

// ---------------------------------------------------------------------------
// Parameters and lists (CLAUDE.md rule 7)
// ---------------------------------------------------------------------------

/// Every change is a new row: values are read by date (ASTA-09).
model Setting {
  id              String   @id @default(uuid(7)) @db.Uuid
  key             String
  value           Json
  version         Int
  validFrom       DateTime @db.Timestamptz(3)
  changedByUserId String?  @db.Uuid
  reason          String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([key, version])
  @@index([key, validFrom])
}

model ListValue {
  id        String   @id @default(uuid(7)) @db.Uuid
  listKey   String
  code      String
  labelIt   String
  labelSq   String
  active    Boolean  @default(true)
  sortOrder Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([listKey, code])
}

/// Italian municipalities from ISTAT (seed/comuni.csv): the cadastral code is
/// the one in the fiscal code.
model Municipality {
  istatCode     String   @id
  cadastralCode String   @unique
  province      String
  name          String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([name])
}

/// Excluded cases (ASTA-10), from the exclusionCase list of seed/elenchi.json.
model ExclusionRule {
  code             String   @id
  /// Extra machine-readable condition, for cases the automatic check detects.
  condition        Json?
  blockingInWizard Boolean
  messageIt        String
  messageSq        String
  active           Boolean  @default(true)
  /// The version in force (phase 7): every change keeps a copy in ExclusionRuleVersion.
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @db.Timestamptz(3)
}

/// Every version of an excluded case, with who changed it and why (spec 07).
model ExclusionRuleVersion {
  id               String   @id @default(uuid(7)) @db.Uuid
  code             String
  version          Int
  condition        Json?
  blockingInWizard Boolean
  messageIt        String
  messageSq        String
  active           Boolean
  reason           String?
  changedByUserId  String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@unique([code, version])
}

/// Coverage packages (spec 09 §2, seed/pacchetti.json). A request stores the
/// version it used.
model CoveragePackage {
  code      String                   @id
  name      String
  versions  CoveragePackageVersion[]
  createdAt DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                 @default(now()) @db.Timestamptz(3)
}

model CoveragePackageVersion {
  id              String          @id @default(uuid(7)) @db.Uuid
  packageCode     String
  package         CoveragePackage @relation(fields: [packageCode], references: [code])
  version         Int
  requirements    Json
  customerTextIt  String
  /// Phase 7: the text in Albanian, for the back office.
  customerTextSq  String?
  validFrom       DateTime        @db.Timestamptz(3)
  reason          String?
  changedByUserId String?         @db.Uuid
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([packageCode, version])
}

/// National holidays: auction time does not run (ASTA-02).
model Holiday {
  id        String   @id @default(uuid(7)) @db.Uuid
  date      DateTime @unique @db.Date
  name      String
  /// Phase 7: the name in Albanian, for the back office.
  nameSq    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// Audit log, domain events, outbox
// ---------------------------------------------------------------------------

/// Append only with a hash chain (SIC-04): UPDATE and DELETE are refused by the
/// database; each row contains the hash of the previous one.
model AuditLog {
  seq                 BigInt   @id @default(autoincrement())
  at                  DateTime @db.Timestamptz(3)
  actorUserId         String?  @db.Uuid
  actorMembershipId   String?  @db.Uuid
  actorOrganizationId String?  @db.Uuid
  action              String
  targetType          String?
  targetId            String?
  before              Json?
  after               Json?
  reason              String?
  ip                  String?
  userAgent           String?
  prevHash            String   @unique
  hash                String   @unique

  @@index([actorOrganizationId, at])
  @@index([targetType, targetId])
  @@index([action, at])
}

/// History shown to users; written in the same transaction as the state change.
model DomainEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  aggregateType String
  aggregateId   String   @db.Uuid
  type          String
  at            DateTime @db.Timestamptz(3)
  actorUserId   String?  @db.Uuid
  data          Json     @default("{}")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([aggregateType, aggregateId, at])
}

enum OutboxStatus {
  PENDING
  DELIVERED
  FAILED
}

/// Reliable delivery to notifications and Temporal. Payload: identifiers only (SIC-06).
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  type          String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @db.Timestamptz(3)
  lastErrorCode String?
  deliveredAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Customers and requests (phase 2, ADR 0007)
// Every row has an owner for row level security: ownerUserId for a private
// customer, ownerOrganizationId (+ ownerMembershipId) for a broker.
// ---------------------------------------------------------------------------

enum PersonKind {
  PERSON
  COMPANY
}

/// Contacts live only here, encrypted, never in quoteData (VIS-01).
model Customer {
  id                  String    @id @default(uuid(7)) @db.Uuid
  ownerUserId         String?   @db.Uuid
  ownerOrganizationId String?   @db.Uuid
  ownerMembershipId   String?   @db.Uuid
  personId            String    @db.Uuid
  emailEnc            String?
  emailHash           String?
  phoneEnc            String?
  phoneHash           String?
  contactsVerifiedAt  DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @db.Timestamptz(3)

  person        Person         @relation(fields: [personId], references: [id])
  vehicles      Vehicle[]
  quoteRequests QuoteRequest[]
  consents      Consent[]

  @@index([ownerUserId])
  @@index([ownerOrganizationId])
  @@index([emailHash])
  @@index([phoneHash])
}

model Person {
  id                  String     @id @default(uuid(7)) @db.Uuid
  ownerUserId         String?    @db.Uuid
  ownerOrganizationId String?    @db.Uuid
  kind                PersonKind
  surname             String?
  givenName           String?
  companyName         String?
  fiscalCodeEnc       String?
  fiscalCodeHash      String?
  vatNumberEnc        String?
  vatNumberHash       String?
  birthDate           DateTime?  @db.Date
  birthPlace          String?
  sex                 String?
  /// Street, postal code, ISTAT code of the municipality, province.
  residence           Json?
  profession          String?
  maritalStatus       String?
  children            Int?
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @default(now()) @db.Timestamptz(3)

  customers Customer[]

  @@index([fiscalCodeHash])
  @@index([vatNumberHash])
  @@index([ownerOrganizationId])
}

model Vehicle {
  id                  String   @id @default(uuid(7)) @db.Uuid
  ownerUserId         String?  @db.Uuid
  ownerOrganizationId String?  @db.Uuid
  customerId          String   @db.Uuid
  plate               String
  /// Technical data as in quoteData.vehicle, without the plate.
  data                Json
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, plate])
}

enum RequestChannel {
  PRIVATE
  BROKER
}

enum QuoteRequestStatus {
  DRAFT
  IN_VERIFICATION
  INTEGRATION_REQUESTED
  EXCLUDED
  AUCTION_OPEN
  OFFERS_AVAILABLE
  DESERTED
  ACCEPTED
  IN_ISSUANCE
  ISSUED
  EXPIRED
  IN_RECONFIRMATION
  CANCELLED
}

enum CheckOutcome {
  GREEN
  YELLOW
  RED
}

model QuoteRequest {
  id                    String             @id @default(uuid(7)) @db.Uuid
  /// AX-2026-000001; prefix from requests.codePrefix.
  code                  String             @unique
  channel               RequestChannel
  ownerUserId           String?            @db.Uuid
  ownerOrganizationId   String?            @db.Uuid
  requesterUserId       String             @db.Uuid
  requesterMembershipId String?            @db.Uuid
  customerId            String?            @db.Uuid
  status                QuoteRequestStatus @default(DRAFT)
  /// QuoteDraft encrypted (ADR 0007); null after submission.
  draftEnc              String?
  /// Version of quoteData in force (QuoteDataVersion), null while a draft.
  quoteDataVersion      Int?
  plate                 String?
  vehicleType           String?
  province              String?
  cuClass               Int?
  claimsLast5y          Int?
  youngestDriverAge     Int?
  packageCode           String?
  startDate             DateTime?          @db.Date
  minValidityDays       Int?
  auctionDurationHours  Int?
  autoOutcome           CheckOutcome?
  aiComparisonUsed      Boolean            @default(false)
  reconfirmationsUsed   Int                @default(0)
  renewalOfPolicyId     String?            @db.Uuid
  submittedAt           DateTime?          @db.Timestamptz(3)
  cancelledAt           DateTime?          @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @default(now()) @db.Timestamptz(3)

  customer          Customer?           @relation(fields: [customerId], references: [id])
  quoteDataVersions QuoteDataVersion[]
  documents         Document[]
  verifications     Verification[]
  events            QuoteRequestEvent[]
  consentLinks      ConsentLink[]
  auctions          Auction[]
  acceptances       Acceptance[]
  aiSuggestions     AiSuggestion[]
  customerLinks     CustomerLink[]

  @@index([ownerUserId, status])
  @@index([ownerOrganizationId, status])
  @@index([status, submittedAt])
}

enum QuoteDataSource {
  SUBMISSION
  INTEGRATION
  BACK_OFFICE_CORRECTION
}

/// Append only (ADR 0007): every change of quoteData is a new version.
model QuoteDataVersion {
  id                  String          @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String          @db.Uuid
  ownerUserId         String?         @db.Uuid
  ownerOrganizationId String?         @db.Uuid
  version             Int
  dataEnc             String
  dataSha256          String
  source              QuoteDataSource
  /// Paths of the fields changed from the previous version.
  changedFields       Json            @default("[]")
  reason              String?
  createdByUserId     String          @db.Uuid
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  @@unique([quoteRequestId, version])
}

enum ConsentType {
  DATA_SHARING_AGENCIES
}

enum ConsentMethod {
  OTP_PRIVATE
  OTP_LINK
  UPLOADED_BY_BROKER
}

/// LEG-04: the customer's consent to share the request with the invited agencies.
model Consent {
  id                  String        @id @default(uuid(7)) @db.Uuid
  customerId          String        @db.Uuid
  ownerUserId         String?       @db.Uuid
  ownerOrganizationId String?       @db.Uuid
  quoteRequestId      String?       @db.Uuid
  type                ConsentType
  legalVersionId      String?       @db.Uuid
  method              ConsentMethod
  /// Identifiers only: OTP challenge, document, IP and browser.
  evidence            Json
  acceptedAt          DateTime      @db.Timestamptz(3)
  revokedAt           DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, type])
}

enum ConsentLinkStatus {
  SENT
  COMPLETED
  EXPIRED
  REVOKED
}

/// Link sent by a broker to the customer for the consent (consent.signature_request).
model ConsentLink {
  id                  String            @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String            @db.Uuid
  customerId          String            @db.Uuid
  ownerOrganizationId String            @db.Uuid
  tokenHash           String            @unique
  status              ConsentLinkStatus @default(SENT)
  expiresAt           DateTime          @db.Timestamptz(3)
  sentByUserId        String            @db.Uuid
  completedAt         DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])
}

enum OtpPurpose {
  PRIVATE_CONSENT
  LINK_CONSENT
  /// Phase 5: the broker's customer confirms the identity on the link (decision 26).
  CUSTOMER_LINK
  /// Phase 7: the owner confirms the IBAN of an entry with a code by SMS.
  ONBOARDING_IBAN
}

/// One-time codes sent by AstAx (auth.otp), stored only as a keyed hash.
model OtpChallenge {
  id                  String     @id @default(uuid(7)) @db.Uuid
  purpose             OtpPurpose
  /// The request (private consent) or the consent link.
  subjectId           String     @db.Uuid
  ownerUserId         String?    @db.Uuid
  ownerOrganizationId String?    @db.Uuid
  codeHash            String
  /// When the code was sent, from Clock (rule 6): the wait before a new code.
  issuedAt            DateTime?  @db.Timestamptz(3)
  expiresAt           DateTime   @db.Timestamptz(3)
  attempts            Int        @default(0)
  maxAttempts         Int
  consumedAt          DateTime?  @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @default(now()) @db.Timestamptz(3)

  @@index([subjectId, purpose])
}

enum DocumentKind {
  REGISTRATION_CERTIFICATE
  DRIVING_LICENCE
  RISK_CERTIFICATE
  FISCAL_CODE_CARD
  CONSENT_FORM
  /// The PDF quote of an offer, stored after the closing (docs/busta-chiusa.md, step 5).
  OFFER_QUOTE
  /// The information set of a product of the agency library (decision 17, LEG-05).
  PRODUCT_DIP
  PRODUCT_DIP_ADDITIONAL
  PRODUCT_CONDITIONS
  /// Phase 5 (LEG-05): what the customer reads and signs at the acceptance.
  PRECONTRACTUAL_INFO
  ENGAGEMENT_LETTER
  SIGNED_DOCUMENT
  SIGNATURE_EVIDENCE
  /// Phase 6 (EMI-02): what the agency uploads at the issuance.
  ISSUED_POLICY
  POLICY_RECEIPT
  INSURANCE_CERTIFICATE
  /// Phase 6 (CONT-03): the courtesy copy of an invoice.
  INVOICE_PDF
  OTHER
}

model Document {
  id                  String       @id @default(uuid(7)) @db.Uuid
  kind                DocumentKind
  ownerUserId         String?      @db.Uuid
  ownerOrganizationId String?      @db.Uuid
  quoteRequestId      String?      @db.Uuid
  customerId          String?      @db.Uuid
  /// For a licence: the driver's index in quoteData.drivers.
  driverIndex         Int?
  /// For the information set: the product of the agency library. The latest
  /// document of each kind is the current one; older ones stay as history.
  productId           String?      @db.Uuid
  /// Opaque key, never a name (CLAUDE.md rule 8).
  storageKey          String       @unique
  sha256              String
  mime                String
  size                Int
  fileName            String
  encryption          String       @default("SSE_KMS")
  uploadedByUserId    String       @db.Uuid
  /// Fields read by the document reader, with confidence, encrypted (ADR 0007):
  /// they hold names, fiscal codes and licence numbers.
  extractionEnc       String?
  extractedAt         DateTime?    @db.Timestamptz(3)
  retainUntil         DateTime?    @db.Timestamptz(3)
  deletedAt           DateTime?    @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest?     @relation(fields: [quoteRequestId], references: [id])
  product      InsuranceProduct? @relation(fields: [productId], references: [id])

  @@index([quoteRequestId])
  @@index([productId])
}

enum VerificationDecision {
  APPROVED
  INTEGRATION_REQUESTED
  EXCLUDED
}

/// One per submission round: the automatic check and the back office decision.
model Verification {
  id                  String                @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String                @db.Uuid
  ownerUserId         String?               @db.Uuid
  ownerOrganizationId String?               @db.Uuid
  round               Int
  quoteDataVersion    Int
  autoOutcome         CheckOutcome
  /// Items: code, automatic outcome, reasons, fields, correction, note.
  checklist           Json
  assignedToUserId    String?               @db.Uuid
  decision            VerificationDecision?
  reasonCodes         Json                  @default("[]")
  message             String?
  decidedByUserId     String?               @db.Uuid
  decidedAt           DateTime?             @db.Timestamptz(3)
  excludedAgencies    Json                  @default("[]")
  /// Integration: draft sections and document kinds the requester may change (question 9).
  integrationScope    Json?
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  @@unique([quoteRequestId, round])
  @@index([decision, createdAt])
}

/// The request's timeline, shown to requester and back office. Append only;
/// details hold codes and identifiers only.
model QuoteRequestEvent {
  id                  String   @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String   @db.Uuid
  ownerUserId         String?  @db.Uuid
  ownerOrganizationId String?  @db.Uuid
  type                String
  actorKind           String
  actorUserId         String?  @db.Uuid
  details             Json     @default("{}")
  at                  DateTime @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  @@index([quoteRequestId, at])
}

enum NotificationStatus {
  UNREAD
  READ
}

/// In-app notifications (docs/notifiche.md); payload holds identifiers and the rendered text only.
model Notification {
  id        String             @id @default(uuid(7)) @db.Uuid
  userId    String             @db.Uuid
  eventKey  String
  title     String
  body      String
  link      String?
  payload   Json               @default("{}")
  status    NotificationStatus @default(UNREAD)
  readAt    DateTime?          @db.Timestamptz(3)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @default(now()) @db.Timestamptz(3)

  @@index([userId, status, createdAt])
}

// ---------------------------------------------------------------------------
// Companies and agencies (phase 3; screens of the agencies in phase 4)
// ---------------------------------------------------------------------------

/// Insurance companies; in development and tests only invented names (rule 11).
model InsuranceCompany {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  ivassCode String?  @unique
  group     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)

  mandates   AgencyMandate[]
  products   InsuranceProduct[]
  complaints CompanyComplaintsIndex[]
}

/// PRES-07: the IVASS complaints index of a company, entered by the back office.
model CompanyComplaintsIndex {
  id              String   @id @default(uuid(7)) @db.Uuid
  companyId       String   @db.Uuid
  year            Int
  /// Complaints per 10.000 contracts: lower is better. Not money.
  value           Float
  source          String
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @db.Timestamptz(3)

  company InsuranceCompany @relation(fields: [companyId], references: [id])

  @@unique([companyId, year])
}

enum MandateSource {
  RUI
  MANUAL
}

/// OFF-04: an agency offers only with the companies of its verified mandates.
model AgencyMandate {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  companyId      String        @db.Uuid
  source         MandateSource
  verifiedAt     DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  company InsuranceCompany @relation(fields: [companyId], references: [id])

  @@unique([organizationId, companyId])
}

/// Decision 17: the agency's product library; the information set arrives in phase 4.
model InsuranceProduct {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @db.Uuid
  companyId      String   @db.Uuid
  name           String
  version        Int      @default(1)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  company   InsuranceCompany @relation(fields: [companyId], references: [id])
  documents Document[]

  @@unique([organizationId, companyId, name, version])
}

/// ASTA-05: the requests the agency wants to receive (criteria: AgencyFilterCriteria).
model AgencyFilter {
  organizationId  String   @id @db.Uuid
  criteria        Json
  updatedByUserId String?  @db.Uuid
  updatedAt       DateTime @default(now()) @db.Timestamptz(3)
}

/// VIS-06: a member's filters, always inside the agency's.
model MemberFilter {
  membershipId String   @id @db.Uuid
  criteria     Json
  updatedAt    DateTime @default(now()) @db.Timestamptz(3)
}

enum RequestDistribution {
  ALL_USERS
  BY_MEMBER_FILTERS
}

/// ASTA-05: daily capacity (invitations per calendar day, Rome; null = no limit),
/// reception hours (WeeklyHours), pause and distribution among the members.
model AgencyCapacity {
  organizationId String              @id @db.Uuid
  dailyMax       Int?
  receptionHours Json
  pausedUntil    DateTime?           @db.Timestamptz(3)
  distribution   RequestDistribution @default(ALL_USERS)
  updatedAt      DateTime            @default(now()) @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// Auctions and offers (phase 3)
// ---------------------------------------------------------------------------

enum AuctionKind {
  MAIN
  REOPEN
  RECONFIRMATION
}

enum AuctionStatus {
  OPEN
  CLOSING
  CLOSED
  CANCELLED
}

/// One row per round (docs/busta-chiusa.md). The owner columns repeat the
/// request's, for row level security.
model Auction {
  id                  String        @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String        @db.Uuid
  ownerUserId         String?       @db.Uuid
  ownerOrganizationId String?       @db.Uuid
  kind                AuctionKind
  round               Int
  status              AuctionStatus @default(OPEN)
  openedAt            DateTime      @db.Timestamptz(3)
  scheduledCloseAt    DateTime      @db.Timestamptz(3)
  originalCloseAt     DateTime      @db.Timestamptz(3)
  closedAt            DateTime?     @db.Timestamptz(3)
  /// GAR-01, Rome calendar date.
  minGuaranteeDate    DateTime      @db.Date
  durationHours       Int
  /// ASTA-09: parameters in force at the opening.
  settingsSnapshot    Json
  /// X25519 public key of the round; the private one only wrapped by the KMS.
  publicKey           String
  wrappedPrivateKey   String
  kmsKeyRef           String
  /// Extensions by the back office, each with reason and author (ASTA-06).
  extensions          Json          @default("[]")
  cancelReason        String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])
  invitations  Invitation[]
  claims       Claim[]
  offers       Offer[]

  @@unique([quoteRequestId, round])
  @@index([status, scheduledCloseAt])
}

enum InvitationSource {
  AUTO
  TOP_UP
  BACK_OFFICE
  RENEWAL
  REOPEN
  RECONFIRMATION
}

enum InvitationStatus {
  INVITED
  VIEWED
  CLAIMED
  OFFERED
  DECLINED
}

model Invitation {
  id              String           @id @default(uuid(7)) @db.Uuid
  auctionId       String           @db.Uuid
  organizationId  String           @db.Uuid
  source          InvitationSource
  invitedAt       DateTime         @db.Timestamptz(3)
  invitedByUserId String?          @db.Uuid
  firstViewedAt   DateTime?        @db.Timestamptz(3)
  status          InvitationStatus @default(INVITED)
  declineReason   String?

  auction Auction @relation(fields: [auctionId], references: [id])

  @@unique([auctionId, organizationId])
  @@index([organizationId, invitedAt])
}

/// ASTA-06: an agency the back office left out of the preview, with the reason.
model InvitationExclusion {
  id             String   @id @default(uuid(7)) @db.Uuid
  quoteRequestId String   @db.Uuid
  organizationId String   @db.Uuid
  reason         String
  byUserId       String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([quoteRequestId, organizationId])
}

/// OFF-03: the claim locks the request for the colleagues of the same agency.
/// One natural person is one user (OFF-02): `userId` identifies the person.
model Claim {
  id               String    @id @default(uuid(7)) @db.Uuid
  auctionId        String    @db.Uuid
  organizationId   String    @db.Uuid
  membershipId     String    @db.Uuid
  userId           String    @db.Uuid
  claimedAt        DateTime  @db.Timestamptz(3)
  releasedAt       DateTime? @db.Timestamptz(3)
  releasedByUserId String?   @db.Uuid

  auction Auction @relation(fields: [auctionId], references: [id])

  @@index([auctionId])
}

enum OfferStatus {
  SUBMITTED
  WITHDRAWN
  EXCLUDED
  AWAITING_CUSTOMER
  WINNING
  ISSUED
  NOT_CHOSEN
  EXPIRED
  MISSED_ISSUANCE
}

/// BC-02: before the closing only sealed values; the plain columns are filled
/// by the closing activity of the worker.
model Offer {
  id                      String      @id @default(uuid(7)) @db.Uuid
  auctionId               String      @db.Uuid
  organizationId          String      @db.Uuid
  membershipId            String      @db.Uuid
  userId                  String      @db.Uuid
  status                  OfferStatus @default(SUBMITTED)
  submittedAt             DateTime    @db.Timestamptz(3)
  /// PRES-01: server time of the submission or of the last change.
  lastChangedAt           DateTime    @db.Timestamptz(3)
  withdrawnAt             DateTime?   @db.Timestamptz(3)
  version                 Int         @default(1)
  sealedPayload           String
  sealedPdfKey            String?
  sealedPdfDataKey        String?
  /// BC-04: copy for the agency, under a separate key.
  ownerCopy               String
  annualGrossPremiumCents Int?
  companyId               String?     @db.Uuid
  productId               String?     @db.Uuid
  coverage                Json?
  guaranteeUntil          DateTime?   @db.Date
  notes                   String?
  pdfDocumentId           String?     @db.Uuid
  exclusionReason         String?
  reviewFlags             Json?
  rank                    Int?
  createdAt               DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime    @default(now()) @db.Timestamptz(3)

  auction    Auction          @relation(fields: [auctionId], references: [id])
  versions   OfferVersion[]
  quoteCheck OfferQuoteCheck?

  @@index([auctionId])
  @@index([organizationId, status])
}

enum QuoteCheckResult {
  MATCH
  MISMATCH
  UNREADABLE
}

enum QuoteCheckDecision {
  EXCLUDED
  KEPT
}

/// OFF-09: after the closing, the PDF quote read and compared with the declared
/// offer. A difference is a flag for the back office, which may exclude the
/// offer with a reason until the customer accepts it; it never excludes by itself.
model OfferQuoteCheck {
  id              String              @id @default(uuid(7)) @db.Uuid
  offerId         String              @unique @db.Uuid
  quoteRequestId  String              @db.Uuid
  checkedAt       DateTime            @db.Timestamptz(3)
  result          QuoteCheckResult
  /// The fields that differ, with the declared and the read value (whole cents or names).
  differences     Json                @default("[]")
  readerModel     String
  promptVersion   String
  decision        QuoteCheckDecision?
  decidedAt       DateTime?           @db.Timestamptz(3)
  decidedByUserId String?             @db.Uuid
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)

  offer Offer @relation(fields: [offerId], references: [id])

  @@index([result, decision])
}

/// Earlier versions of an offer, always sealed; rows are only added.
model OfferVersion {
  id               String   @id @default(uuid(7)) @db.Uuid
  offerId          String   @db.Uuid
  organizationId   String   @db.Uuid
  version          Int
  sealedPayload    String
  sealedPdfKey     String?
  sealedPdfDataKey String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  offer Offer @relation(fields: [offerId], references: [id])

  @@unique([offerId, version])
}

/// CLA-01: the valid offers of the round in order; published by CLA-02.
model Ranking {
  id             String    @id @default(uuid(7)) @db.Uuid
  quoteRequestId String    @db.Uuid
  auctionId      String    @unique @db.Uuid
  entries        Json
  validCount     Int
  publishedAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
}

/// ADR 0005: every use of a KMS key, the stand-in for CloudTrail (BC-03);
/// identifiers only in the context. Rows are only added.
model KmsEvent {
  seq       BigInt   @id @default(autoincrement())
  at        DateTime @db.Timestamptz(3)
  keyId     String
  operation String
  context   Json
  ok        Boolean
  process   String

  @@index([keyId, at])
}

// ---------------------------------------------------------------------------
// Acceptance and payment (phase 5)
// ---------------------------------------------------------------------------

/// PRES-08: every AI suggestion with weights, data used, scores, model, prompt
/// version and the text shown (or the fallback text, proposal D).
model AiSuggestion {
  id                  String   @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String   @db.Uuid
  ownerUserId         String?  @db.Uuid
  ownerOrganizationId String?  @db.Uuid
  offerIds            Json
  weights             Json
  inputs              Json
  scores              Json
  recommendedOfferId  String   @db.Uuid
  text                String
  /// MODEL when the model's text passed the check, FALLBACK otherwise.
  textSource          String
  textProblems        Json     @default("[]")
  model               String
  promptVersion       String
  shownAt             DateTime @db.Timestamptz(3)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  @@index([quoteRequestId])
}

/// Decision 26: the broker sends offers to the customer, who opens the link,
/// confirms the identity with a code, signs and pays the premium only.
model CustomerLink {
  id                  String    @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String    @db.Uuid
  ownerOrganizationId String    @db.Uuid
  offerIds            Json
  tokenHash           String    @unique
  /// Until the end of the guarantee of the offers sent (decision 26).
  expiresAt           DateTime  @db.Timestamptz(3)
  otpVerifiedAt       DateTime? @db.Timestamptz(3)
  sentByUserId        String    @db.Uuid
  revokedAt           DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])
  acceptances  Acceptance[]

  @@index([quoteRequestId])
}

enum AcceptanceStatus {
  PENDING_SIGNATURE
  SIGNED
  PAID
  VOIDED
}

/// One per chosen offer: a new one when the customer changes offer (decision
/// 22). The fee is computed at its creation with the rule applied (FEE-01…03).
model Acceptance {
  id                  String           @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String           @db.Uuid
  offerId             String           @db.Uuid
  ownerUserId         String?          @db.Uuid
  ownerOrganizationId String?          @db.Uuid
  /// The private user, or null when the broker's customer accepted on a link.
  acceptedByUserId    String?          @db.Uuid
  customerLinkId      String?          @db.Uuid
  premiumCents        Int
  feeCents            Int
  feeRule             String
  /// FEE-03: owed by the broker once the policy is issued.
  brokerFeeCents      Int              @default(0)
  /// EMI-04: what the customer already paid for the offer that was not issued;
  /// a second offer or a new price charges or refunds only the difference.
  creditPremiumCents  Int              @default(0)
  creditFeeCents      Int              @default(0)
  aiUsed              Boolean
  status              AcceptanceStatus @default(PENDING_SIGNATURE)
  signedAt            DateTime?        @db.Timestamptz(3)
  paidAt              DateTime?        @db.Timestamptz(3)
  /// EMI-01, computed at the payment.
  issuanceDeadlineAt  DateTime?        @db.Timestamptz(3)
  voidedAt            DateTime?        @db.Timestamptz(3)
  voidReason          String?
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @default(now()) @db.Timestamptz(3)

  quoteRequest QuoteRequest       @relation(fields: [quoteRequestId], references: [id])
  customerLink CustomerLink?      @relation(fields: [customerLinkId], references: [id])
  signature    SignatureEnvelope?
  payments     Payment[]

  @@index([quoteRequestId, status])
}

enum SignatureStatus {
  PENDING
  SIGNED
  REJECTED
  EXPIRED
}

/// LEG-05: the documents to sign (letter of engagement) and to read (MUP,
/// information set), the signed files and the evidence.
model SignatureEnvelope {
  id                  String          @id @default(uuid(7)) @db.Uuid
  acceptanceId        String          @unique @db.Uuid
  ownerUserId         String?         @db.Uuid
  ownerOrganizationId String?         @db.Uuid
  provider            String
  providerRef         String          @unique
  /// Where the signer signs, as the provider gave it.
  signingUrl          String
  status              SignatureStatus @default(PENDING)
  /// The document ids given to read and sign.
  documentIds         Json
  signedDocumentIds   Json            @default("[]")
  evidenceDocumentId  String?         @db.Uuid
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @default(now()) @db.Timestamptz(3)

  acceptance Acceptance @relation(fields: [acceptanceId], references: [id])
}

enum PaymentMethod {
  CARD
  INSTANT_TRANSFER
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// PAG-01, decision 21: one payment, premium and fee kept apart.
model Payment {
  id                  String         @id @default(uuid(7)) @db.Uuid
  acceptanceId        String         @db.Uuid
  ownerUserId         String?        @db.Uuid
  ownerOrganizationId String?        @db.Uuid
  provider            String
  providerRef         String?        @unique
  /// The provider's payment page.
  redirectUrl         String?
  method              PaymentMethod?
  premiumCents        Int
  feeCents            Int
  status              PaymentStatus  @default(CREATED)
  capturedAt          DateTime?      @db.Timestamptz(3)
  failedAt            DateTime?      @db.Timestamptz(3)
  idempotencyKey      String         @unique
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @default(now()) @db.Timestamptz(3)

  acceptance Acceptance @relation(fields: [acceptanceId], references: [id])

  @@index([acceptanceId])
}

/// The webhooks of the providers, handled once (docs/modello-dati.md).
model ProviderEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  provider   String
  eventId    String
  type       String
  receivedAt DateTime @db.Timestamptz(3)

  @@unique([provider, eventId])
}

// ---------------------------------------------------------------------------
// Phase 6: after the purchase (docs/modello-dati.md, «Accettazione, pagamenti,
// polizze»). Amounts in whole cents (rule 5); the system writes, the owners read.
// ---------------------------------------------------------------------------

enum PolicyStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  WITHDRAWN
  CANCELLED
}

/// EMI-02: the policy the winning agency issued. Owner fields are the
/// requester's (private user or broker); `organizationId` is the issuing agency.
model Policy {
  id                  String       @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String       @unique @db.Uuid
  offerId             String       @db.Uuid
  acceptanceId        String       @db.Uuid
  organizationId      String       @db.Uuid
  companyId           String       @db.Uuid
  ownerUserId         String?      @db.Uuid
  ownerOrganizationId String?      @db.Uuid
  policyNumber        String
  startDate           DateTime     @db.Date
  endDate             DateTime     @db.Date
  premiumCents        Int
  issuedAt            DateTime     @db.Timestamptz(3)
  issuedByUserId      String       @db.Uuid
  status              PolicyStatus @default(ACTIVE)
  /// Spec 02 «Rinnovi»: the broker's automatic renewal.
  autoRenewal         Boolean      @default(false)
  /// The request opened for the renewal, once.
  renewalRequestId    String?      @db.Uuid
  /// Decision 24: the broker's invoice B that billed its fee (FEE-03), once.
  brokerInvoiceId     String?      @db.Uuid
  brokerInvoice       Invoice?     @relation("BrokerInvoicePolicies", fields: [brokerInvoiceId], references: [id], onDelete: Restrict)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @default(now()) @db.Timestamptz(3)

  @@index([organizationId, issuedAt])
  @@index([ownerOrganizationId])
  @@index([ownerUserId])
  @@index([endDate])
  @@index([brokerInvoiceId])
}

enum IssuanceProblemType {
  DATA_MISMATCH
  CANNOT_ISSUE
  /// EMI-04: no issuance before the start of cover; opened by the system.
  MISSED_DEADLINE
}

enum IssuanceFault {
  AGENCY
  CUSTOMER
}

enum IssuanceProblemStatus {
  OPEN
  DECIDED
}

/// EMI-04: a case for the back office, opened by the agency or the system.
model IssuanceProblem {
  id              String                @id @default(uuid(7)) @db.Uuid
  quoteRequestId  String                @db.Uuid
  offerId         String                @db.Uuid
  organizationId  String                @db.Uuid
  type            IssuanceProblemType
  /// Written by the agency: no contacts (checked as the offer notes).
  description     String?
  openedByUserId  String?               @db.Uuid
  openedAt        DateTime              @db.Timestamptz(3)
  status          IssuanceProblemStatus @default(OPEN)
  fault           IssuanceFault?
  decidedByUserId String?               @db.Uuid
  decidedAt       DateTime?             @db.Timestamptz(3)
  decisionReason  String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @default(now()) @db.Timestamptz(3)

  @@index([quoteRequestId])
  @@index([status])
}

enum NextOfferKind {
  /// EMI-04, decision 28: the best offer still guaranteed of another agency.
  SECOND_OFFER
  /// EMI-04: wrong customer data, the same agency's new price.
  REPRICE
}

enum NextOfferStatus {
  PROPOSED
  ACCEPTED
  REFUSED
  EXPIRED
}

/// EMI-04: what the customer is asked to confirm within
/// `secondOffer.customerConfirmHours`.
model NextOfferProposal {
  id                  String          @id @default(uuid(7)) @db.Uuid
  quoteRequestId      String          @db.Uuid
  ownerUserId         String?         @db.Uuid
  ownerOrganizationId String?         @db.Uuid
  kind                NextOfferKind
  fromOfferId         String          @db.Uuid
  toOfferId           String          @db.Uuid
  premiumCents        Int
  feeCents            Int
  /// Positive: the customer pays it; negative: AstAx gives it back.
  differenceCents     Int
  expiresAt           DateTime        @db.Timestamptz(3)
  status              NextOfferStatus @default(PROPOSED)
  decidedAt           DateTime?       @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @default(now()) @db.Timestamptz(3)

  @@index([quoteRequestId])
  @@index([status, expiresAt])
}

enum PenaltyType {
  LATE_ISSUANCE
  MISSED_ISSUANCE
  CIRCUMVENTION
}

enum PenaltyStatus {
  PROPOSED
  APPLIED
  CONTESTED
  UPHELD
  CANCELLED
}

/// EMI-05, decision 29: proposed, applied by the supervisor, contested within
/// `penalties.contestDays`, decided by the administrator; held back from the
/// remittances (RemittanceLine) until paid.
model Penalty {
  id               String        @id @default(uuid(7)) @db.Uuid
  organizationId   String        @db.Uuid
  type             PenaltyType
  amountCents      Int
  quoteRequestId   String?       @db.Uuid
  status           PenaltyStatus @default(PROPOSED)
  reason           String
  proposedByUserId String?       @db.Uuid
  proposedAt       DateTime      @db.Timestamptz(3)
  appliedByUserId  String?       @db.Uuid
  appliedAt        DateTime?     @db.Timestamptz(3)
  contestUntil     DateTime?     @db.Timestamptz(3)
  contestText      String?
  contestedAt      DateTime?     @db.Timestamptz(3)
  decision         String?
  decidedByUserId  String?       @db.Uuid
  decidedAt        DateTime?     @db.Timestamptz(3)
  /// Decision 27: the missed issuance replaces the delay.
  replacesId       String?       @db.Uuid
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @default(now()) @db.Timestamptz(3)

  @@index([organizationId, status])
  @@index([quoteRequestId])
}

/// EMI-06, decision 30: out of the invitations until the administrator revokes.
model AgencySuspension {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @db.Uuid
  reason            String
  startedAt         DateTime  @db.Timestamptz(3)
  confirmedByUserId String?   @db.Uuid
  confirmedAt       DateTime? @db.Timestamptz(3)
  revokedByUserId   String?   @db.Uuid
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @db.Timestamptz(3)

  @@index([organizationId])
}

enum RemittanceStatus {
  DRAFT
  READY
  FILE_GENERATED
  EXECUTED
}

/// CONT-01, CONT-02: the weekly transfer of the premiums to an agency.
model Remittance {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @db.Uuid
  runDate          DateTime         @db.Date
  cutoffAt         DateTime         @db.Timestamptz(3)
  grossCents       Int
  feesCents        Int
  heldCents        Int
  netCents         Int
  carriedCents     Int
  status           RemittanceStatus @default(DRAFT)
  reviewedByUserId String?          @db.Uuid
  sepaFileKey      String?
  executedAt       DateTime?        @db.Timestamptz(3)
  executedByUserId String?          @db.Uuid
  invoiceId        String?          @db.Uuid
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @db.Timestamptz(3)

  lines RemittanceLine[]

  @@unique([organizationId, runDate])
}

enum RemittanceLineKind {
  POLICY
  /// Proposal C of phase 6: the stamp duty of the agency's invoice, held back.
  STAMP_DUTY
  BROKER_SHARE
  CARRIED_OVER
  RECOVERY
  PENALTY
}

/// One policy, or one hold-back as applied (whole or in part).
model RemittanceLine {
  id             String             @id @default(uuid(7)) @db.Uuid
  remittanceId   String             @db.Uuid
  organizationId String             @db.Uuid
  kind           RemittanceLineKind
  /// The policy, penalty, refund or earlier remittance.
  ref            String             @db.Uuid
  /// For a policy: the premium; for a hold-back: what it asked.
  requestedCents Int
  /// For a policy: the agency fee; for a hold-back: what was held this week.
  appliedCents   Int
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)

  remittance Remittance @relation(fields: [remittanceId], references: [id])

  @@index([remittanceId])
  @@index([kind, ref])
}

enum InvoiceSeries {
  P
  A
  B
  /// Credit notes (CONT-03), numbered on their own.
  N
}

enum InvoiceRecipientType {
  PRIVATE
  AGENCY
  BROKER
}

enum SdiStatus {
  TO_SEND
  SENT
  DELIVERED
  REJECTED
}

/// CONT-03, CONT-04, decision 34: the invoices of AstAx's fees, all exempt.
/// A credit note is an Invoice of series N with `creditedInvoiceId`.
model Invoice {
  id                  String               @id @default(uuid(7)) @db.Uuid
  series              InvoiceSeries
  year                Int
  number              Int
  code                String               @unique
  recipientType       InvoiceRecipientType
  ownerUserId         String?              @db.Uuid
  ownerOrganizationId String?              @db.Uuid
  /// Name, fiscal code or VAT number and address, encrypted (ADR 0007).
  recipientEnc        String
  lines               Json
  exemptCents         Int
  stampDutyCents      Int
  totalCents          Int
  vatNature           String
  legalReference      String
  issuedOn            DateTime             @db.Date
  dueOn               DateTime?            @db.Date
  quoteRequestId      String?              @db.Uuid
  remittanceId        String?              @db.Uuid
  /// For the broker's monthly invoice: «2026-11».
  period              String?
  creditedInvoiceId   String?              @db.Uuid
  sdiStatus           SdiStatus            @default(TO_SEND)
  sdiRef              String?
  xmlKey              String?
  pdfDocumentId       String?              @db.Uuid
  /// Decision 24: the policies billed in this broker invoice B.
  brokerPolicies      Policy[]             @relation("BrokerInvoicePolicies")
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @default(now()) @db.Timestamptz(3)

  @@unique([series, year, number])
  @@index([ownerOrganizationId])
  @@index([ownerUserId])
}

/// The gap-free numbering: one row per series and year, locked while a number is taken.
model InvoiceCounter {
  series InvoiceSeries
  year   Int
  last   Int           @default(0)

  @@id([series, year])
}

enum RefundReason {
  BEFORE_ISSUANCE
  WITHDRAWAL
  SECOND_OFFER_DIFFERENCE
  INVALID_ACCEPTANCE
}

enum RefundStatus {
  REQUESTED
  APPROVED
  EXECUTED
  REJECTED
  FAILED
}

/// PAG-04, PAG-05: every refund is approved by the back office supervisor.
model Refund {
  id                        String       @id @default(uuid(7)) @db.Uuid
  paymentId                 String       @db.Uuid
  quoteRequestId            String       @db.Uuid
  ownerUserId               String?      @db.Uuid
  ownerOrganizationId       String?      @db.Uuid
  reason                    RefundReason
  premiumCents              Int
  feeCents                  Int
  /// PAG-04: the agency the refunded premium is recovered from (RemittanceLine RECOVERY).
  recoverFromOrganizationId String?      @db.Uuid
  requestedByUserId         String?      @db.Uuid
  requestedAt               DateTime     @db.Timestamptz(3)
  approvedByUserId          String?      @db.Uuid
  approvedAt                DateTime?    @db.Timestamptz(3)
  status                    RefundStatus @default(REQUESTED)
  providerRef               String?
  executedAt                DateTime?    @db.Timestamptz(3)
  createdAt                 DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime     @default(now()) @db.Timestamptz(3)

  @@index([quoteRequestId])
  @@index([status])
  @@index([recoverFromOrganizationId])
}

enum WithdrawalStatus {
  REQUESTED
  PRICED
  APPROVED
  REJECTED
}

/// PAG-04 after the issuance: the customer's withdrawal, priced by the agency.
model ConsumerWithdrawal {
  id                  String           @id @default(uuid(7)) @db.Uuid
  policyId            String           @unique @db.Uuid
  quoteRequestId      String           @db.Uuid
  organizationId      String           @db.Uuid
  ownerUserId         String?          @db.Uuid
  ownerOrganizationId String?          @db.Uuid
  requestedAt         DateTime         @db.Timestamptz(3)
  requestedByUserId   String           @db.Uuid
  refundableCents     Int?
  pricedByUserId      String?          @db.Uuid
  pricedAt            DateTime?        @db.Timestamptz(3)
  status              WithdrawalStatus @default(REQUESTED)
  decidedByUserId     String?          @db.Uuid
  decidedAt           DateTime?        @db.Timestamptz(3)
  refundId            String?          @db.Uuid
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @default(now()) @db.Timestamptz(3)
}

enum BrokerCommissionStatus {
  ACCRUED
  SETTLED
}

/// Decision 25: the broker's quota, off (0 %) until the lawyer validates it.
model BrokerCommission {
  id             String                 @id @default(uuid(7)) @db.Uuid
  policyId       String                 @unique @db.Uuid
  organizationId String                 @db.Uuid
  amountCents    Int
  status         BrokerCommissionStatus @default(ACCRUED)
  settledAt      DateTime?              @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @default(now()) @db.Timestamptz(3)
}

/// The questionnaire after the sale (`survey.daysAfterIssuance`), opened by link.
model PostSaleSurvey {
  id                String    @id @default(uuid(7)) @db.Uuid
  policyId          String    @unique @db.Uuid
  tokenHash         String    @unique
  sentAt            DateTime  @db.Timestamptz(3)
  answeredAt        DateTime? @db.Timestamptz(3)
  /// Scores and choices only: no free text with personal data.
  answers           Json?
  contactedByOthers Boolean?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @db.Timestamptz(3)
}

enum FlagType {
  CIRCUMVENTION
  FRAUD
}

enum FlagStatus {
  OPEN
  ARCHIVED
  PENALTY_PROPOSED
  SUSPENSION_PROPOSED
}

/// Spec 06 «Segnalazioni»: for the back office only.
model Flag {
  id             String     @id @default(uuid(7)) @db.Uuid
  type           FlagType
  source         String
  quoteRequestId String?    @db.Uuid
  organizationId String?    @db.Uuid
  status         FlagStatus @default(OPEN)
  outcome        String?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @default(now()) @db.Timestamptz(3)

  @@index([status])
}

// ---------------------------------------------------------------------------
// Notifications (phase 7)
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

/// The texts of an event (it, sq) with versions; the latest is in force. The
/// seed loads seed/notifiche.yaml as version 1; the administrator edits it.
model NotificationTemplate {
  id              String                @id @default(uuid(7)) @db.Uuid
  eventKey        String
  version         Int
  recipients      String[]              @default([])
  channels        NotificationChannel[]
  mandatory       Boolean               @default(false)
  forcePush       Boolean               @default(false)
  variables       String[]              @default([])
  /// { it: { title, body, emailSubject, emailBody, sms }, sq?: {…} }
  content         Json
  reason          String?
  changedByUserId String?               @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)

  @@unique([eventKey, version])
}

/// A user's choice for an event and a channel; no row means the default (on).
model NotificationPreference {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @db.Uuid
  eventKey  String
  channel   NotificationChannel
  enabled   Boolean
  updatedAt DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([userId, eventKey, channel])
}

/// A browser's Web Push subscription, encrypted (it is a personal address).
model PushSubscription {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @db.Uuid
  endpointHash    String    @unique
  subscriptionEnc String
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)

  @@index([userId])
}

/// What was sent: the same event to the same recipient and channel within a short window is a duplicate.
model NotificationDispatch {
  id        String              @id @default(uuid(7)) @db.Uuid
  eventKey  String
  dedupeKey String
  userId    String?             @db.Uuid
  /// The hash of the address, for a recipient without an account.
  address   String?
  channel   NotificationChannel
  createdAt DateTime            @default(now()) @db.Timestamptz(3)

  @@index([eventKey, dedupeKey, channel, userId, createdAt], map: "NotificationDispatch_lookup_idx")
}

// ---------------------------------------------------------------------------
// Phase 7: entry of agencies and brokers, the local copy of the RUI
// ---------------------------------------------------------------------------

/// The public registry of intermediaries (IVASS RUI), imported periodically
/// by the worker through the RuiRegistryPort; the entry check reads it here.
model RuiRecord {
  number       String   @id
  /// A, B or E (sections of the registry).
  section      String
  name         String
  /// Section E: the agency or broker the collaborator works for.
  linkedNumber String?
  /// Section A: the companies of the mandates.
  companies    String[] @default([])
  importedAt   DateTime @db.Timestamptz(3)
}

/// One import of the registry per day (Rome), with the counts.
model RuiImport {
  id         String    @id @default(uuid(7)) @db.Uuid
  runDate    String    @unique
  records    Int       @default(0)
  startedAt  DateTime  @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

/// An agency or broker asking to enter (spec 06 «Coda di ingresso»): filled on
/// the site through a private link, checked on the RUI, decided by the back
/// office. Personal data are encrypted, as for organizations and users.
model OnboardingApplication {
  id                     String           @id @default(uuid(7)) @db.Uuid
  type                   OrganizationType
  status                 OnboardingStatus @default(DRAFT)
  /// The private link to go on or correct (only its hash is kept).
  tokenHash              String           @unique
  /// The same link, encrypted, to send it again with the rejection.
  tokenEnc               String
  legalName              String
  vatNumber              String
  fiscalCodeEnc          String?
  ruiNumber              String
  pec                    String
  address                Json
  ibanEnc                String
  ibanConfirmedAt        DateTime?        @db.Timestamptz(3)
  ownerFirstName         String
  ownerLastName          String
  ownerEmailEnc          String
  ownerEmailHash         String
  ownerPhoneEnc          String
  /// Agencies: the companies of the declared mandates.
  companyIds             String[]         @default([]) @db.Uuid
  profInsuranceKey       String?
  profInsuranceSha256    String?
  profInsuranceSize      Int?
  profInsuranceExpiresOn DateTime?        @db.Date
  /// The legal versions accepted, with time, IP and browser (LEG-01).
  acceptedVersionIds     String[]         @default([]) @db.Uuid
  acceptedAt             DateTime?        @db.Timestamptz(3)
  acceptedIp             String?
  acceptedUserAgent      String?
  /// The automatic check on the local RUI at the submission.
  ruiCheck               Json?
  submittedAt            DateTime?        @db.Timestamptz(3)
  decidedAt              DateTime?        @db.Timestamptz(3)
  decidedByUserId        String?          @db.Uuid
  decisionReason         String?
  organizationId         String?          @db.Uuid
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime         @default(now()) @db.Timestamptz(3)

  @@index([status])
  @@index([ownerEmailHash])
}

enum OrganizationNoteKind {
  NOTE
  EXCLUSION_PROPOSAL
}

/// Spec 06 «Agenzie e broker»: the back office notes on an organization and
/// the exclusion proposals, decided by the administrator (spec 07).
model OrganizationNote {
  id              String               @id @default(uuid(7)) @db.Uuid
  organizationId  String               @db.Uuid
  kind            OrganizationNoteKind
  text            String
  authorUserId    String               @db.Uuid
  createdAt       DateTime             @db.Timestamptz(3)
  /// Exclusion proposals: the administrator's decision.
  decision        String?
  decisionReason  String?
  decidedByUserId String?              @db.Uuid
  decidedAt       DateTime?            @db.Timestamptz(3)

  @@index([organizationId])
}

enum DataSubjectRequestKind {
  ACCESS
  RECTIFICATION
  ERASURE
}

enum DataSubjectRequestStatus {
  OPEN
  DONE
  REJECTED
}

/// Spec 06 «Clienti»: a request about personal data (GDPR arts. 15-17),
/// answered within privacy.requestResponseDays.
model DataSubjectRequest {
  id              String                   @id @default(uuid(7)) @db.Uuid
  customerId      String                   @db.Uuid
  kind            DataSubjectRequestKind
  status          DataSubjectRequestStatus @default(OPEN)
  /// What the person asked, as received (no extra personal data).
  description     String
  receivedAt      DateTime                 @db.Timestamptz(3)
  dueAt           DateTime                 @db.Timestamptz(3)
  createdByUserId String                   @db.Uuid
  outcome         String?
  closedByUserId  String?                  @db.Uuid
  closedAt        DateTime?                @db.Timestamptz(3)

  @@index([customerId])
  @@index([status, dueAt])
}

enum SupportTicketStatus {
  OPEN
  WAITING_CUSTOMER
  CLOSED
}

enum SupportChannel {
  EMAIL
  PHONE
  CHAT
}

/// Spec 06 «Assistenza», decision E of phase 7: an internal register of the
/// tickets, linked to a customer or a request; the first answer is due within
/// support.responseHours.
model SupportTicket {
  id               String              @id @default(uuid(7)) @db.Uuid
  number           Int                 @unique @default(autoincrement())
  subject          String
  channel          SupportChannel
  status           SupportTicketStatus @default(OPEN)
  /// Where the replies go (encrypted); none for a phone call.
  contactEmailEnc  String?
  locale           Locale              @default(it)
  customerId       String?             @db.Uuid
  quoteRequestId   String?             @db.Uuid
  assignedToUserId String?             @db.Uuid
  createdByUserId  String              @db.Uuid
  dueAt            DateTime            @db.Timestamptz(3)
  firstAnsweredAt  DateTime?           @db.Timestamptz(3)
  closedAt         DateTime?           @db.Timestamptz(3)
  createdAt        DateTime            @db.Timestamptz(3)
  updatedAt        DateTime            @default(now()) @db.Timestamptz(3)

  messages SupportTicketMessage[]

  @@index([status, dueAt])
  @@index([customerId])
}

model SupportTicketMessage {
  id           String   @id @default(uuid(7)) @db.Uuid
  ticketId     String   @db.Uuid
  /// INBOUND: what the person wrote; REPLY: sent to the person; NOTE: internal.
  kind         String
  text         String
  authorUserId String   @db.Uuid
  createdAt    DateTime @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}
