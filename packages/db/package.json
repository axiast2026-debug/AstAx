{
  "name": "@astax/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "default": "./dist/seed/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:int": "vitest run --config vitest.int.config.ts",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force && tsx src/seed/run.ts",
    "audit:verify": "tsx src/scripts/audit-verify.ts",
    "seed": "tsx src/seed/run.ts",
    "legal:check": "tsx src/scripts/legal-check.ts",
    "reference:municipalities": "tsx src/scripts/import-municipalities.ts",
    "release:check": "tsx src/scripts/release-check.ts",
    "seed:reference": "tsx src/seed/reference-run.ts",
    "reference:postal-codes": "tsx src/scripts/import-postal-codes.ts"
  },
  "dependencies": {
    "@astax/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1",
    "@astax/adapters": "workspace:*",
    "zod": "4.6.7",
    "@testcontainers/postgresql": "12.2.1"
  },
  "devDependencies": {
    "@astax/config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
