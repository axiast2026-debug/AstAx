{
  "name": "astax",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck test test:int",
    "env:init": "node scripts/env-init.mjs",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:ps": "docker compose --env-file .env -f infra/docker-compose.yml ps",
    "db:migrate": "pnpm --filter @astax/db migrate:deploy",
    "db:reset": "pnpm --filter @astax/db reset",
    "audit:verify": "pnpm --filter @astax/db audit:verify",
    "db:seed": "pnpm --filter @astax/db seed",
    "keycloak:sync": "pnpm --filter @astax/api keycloak:sync"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.8"
  }
}
