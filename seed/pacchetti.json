        "naturalEventsVandalism": { "required": false },
        "glass": { "required": false }
      },
      "customerText": {
        "it": "Responsabilità civile con massimale unico di 10 milioni di euro, rinuncia alla rivalsa almeno per patente scaduta e trasporto non conforme, assistenza stradale e tutela legale."
      }
    },
    {
      "code": "COMPLETE",
      "name": "Completo",
      "version": 1,
      "requirements": {
        "rca": { "limitType": "SINGLE_LIMIT", "minSingleLimitEur": 10000000 },
        "recourseWaiver": { "required": true, "minCases": ["EXPIRED_LICENCE", "NON_COMPLIANT_PASSENGER_TRANSPORT"] },
        "roadsideAssistance": { "required": true },
        "legalProtection": { "required": true },
        "driverAccident": { "required": true, "minCapitalEur": 50000 },
