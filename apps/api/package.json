{
  "name": "@astax/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --import tsx src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "keycloak:sync": "tsx src/scripts/keycloak-dev-sync.ts",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@astax/adapters": "workspace:*",
    "@astax/db": "workspace:*",
    "@astax/shared": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@sentry/node": "11.4.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@temporalio/client": "1.24.0",
    "express": "5.3.0",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "pdf-lib": "1.17.1",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astax/config": "workspace:*",
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
